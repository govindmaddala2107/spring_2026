<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Log Directory -->
    <property name="LOG_PATH" value="logs"/>
    <property name="APP_NAME" value="eCom"/>
<!--    <property name="LOG_FILE" value="${LOG_PATH}/{APP_NAME}.log"/>-->

    <!-- Console Appender -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>

    <!-- Rolling File Appender -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        ${LOG_PATH}/${APP_NAME}.log

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- Daily log file -->
            <fileNamePattern>
                ${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <!-- Max size per file -->
            <maxFileSize>1MB</maxFileSize>

            <!-- Keep logs for 30 days -->
            <maxHistory>30</maxHistory>

            <!-- Total log size -->
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>

    <!-- Security Logs -->
<!--    <logger name="org.springframework.security"-->
<!--            level="DEBUG"/>-->

    <!-- Hibernate SQL -->
<!--    <logger name="org.hibernate.SQL"-->
<!--            level="DEBUG"/>-->

<!--    <logger name="org.hibernate.orm.jdbc.bind"-->
<!--            level="TRACE"/>-->

    <!-- Application Package -->
<!--    <logger name="com.gomad.ecom"-->
<!--            level="INFO"/>-->

    <!-- Root Logger -->
    <root level="INFO">

        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>

    </root>

</configuration>